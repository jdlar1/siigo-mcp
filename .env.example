# Siigo API Configuration (ALL REQUIRED)
SIIGO_USERNAME=your_siigo_username
SIIGO_ACCESS_KEY=your_siigo_access_key
SIIGO_PARTNER_ID=yourappname

# Optional
SIIGO_BASE_URL=https://api.siigo.com
# Optional client-side request budget per rolling minute. Use 10 for Siigo test companies; production default is 100.
# SIIGO_REQUESTS_PER_MINUTE=10

# Optional MCP transport (defaults to stdio)
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_AUTH_TOKEN=replace_with_a_long_random_token
# MCP_ALLOWED_HOSTS=mcp.example.com

# Optional: Use sandbox environment for testing
# SIIGO_BASE_URL=https://api.siigo.com
# SIIGO_USERNAME=sandbox@siigoapi.com
# SIIGO_ACCESS_KEY=your_sandbox_access_key
