{
  "name": "siigo-mcp-server",
  "version": "3.0.1",
  "description": "Model Context Protocol (MCP) server for Siigo Colombian accounting software API integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "pnpm build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf dist"
  },
  "bin": {
    "siigo-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "siigo",
    "accounting",
    "api",
    "colombia",
    "invoicing",
    "model-context-protocol",
    "erp",
    "fintech"
  ],
  "author": "Juan Diego De la Rosa <jdidelarc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdlar1/siigo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jdlar1/siigo-mcp/issues"
  },
  "homepage": "https://github.com/jdlar1/siigo-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.13.6",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "jest": "^29.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
